        "import pandas as pd\n",
        "import os\n",
        "\n",
        "pbd_dataset_path = '/content/drive/MyDrive/PBD_Dataset'\n",
        "\n",
        "dataframes_dict = {}\n",
        "#This for loop to load each data as a dataframe and store in the dictionary above\n",
        "for item in file_list:\n",
        "    file_path = os.path.join(pbd_dataset_path, item)\n",
        "    base_name = os.path.splitext(item)[0]\n",
        "\n",
        "    if item.endswith('.csv'):\n",
        "        try:\n",
        "            df = pd.read_csv(file_path)\n",
        "        except UnicodeDecodeError:\n",
        "            # Try reading with a different encoding'\n",
        "\n",
        "            df = pd.read_csv(file_path, encoding='latin-1')\n",
        "        dataframes_dict[base_name] = df\n",
        "    elif item.endswith('.xlsx'):\n",
        "        df = pd.read_excel(file_path) pnp\n",
        "        dataframes_dict[base_name] = df\n",
        "\n",
        "print(\"DataFrames loaded:\", dataframes_dict.keys())"
      ]
    },
